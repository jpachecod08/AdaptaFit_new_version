# ============================================
#  AdaptaFit - Backend (Django) variables
#  Copia este archivo a `.env` y ajusta valores
# ============================================

# Seguridad - EN PRODUCCIÓN define una clave fuerte y única aquí
DJANGO_SECRET_KEY=tu-clave-secreta-super-secreta-cambiar-en-produccion

# DEBUG: solo 'true' en desarrollo. En producción DEJARlo en false.
# Con DEBUG=true Django publica la página de error con toda la configuración
# (incluida la contraseña de la base de datos) en un endpoint público.
DJANGO_DEBUG=True

# # Hosts permitidos (coma-separados), además de localhost/127.0.0.1
# DJANGO_ALLOWED_HOSTS=

# # Orígenes CORS del frontend (coma-separados)
# # Ej: https://adaptafit.netlify.app,http://localhost:5173
# DJANGO_CORS_ORIGINS=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

MEDIA_URL=/media/

# Base de datos - usa DATABASE_URL (preferido) o las DB_* individuales
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_NAME=adaptafit_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AdaptaFit <no-reply@adaptafit.app>

# ============================================
#  Google Gemini API (Paso 3) - Gratis
#  Obtén tu API key en https://aistudio.google.com/
# ============================================
GEMINI_API_KEY=

# Modelo Gemini a usar (respaldado por una lista de fallback en ai_engine.py)
GEMINI_MODEL=gemini-3.6-flash

# ============================================
#  Fotos de las maquinas (subidas por el entrenador)
# ============================================
# En produccion las fotos NO deben ir al disco de Render: es efimero y se
# pierden en cada redespliegue. Usa Supabase Storage con su endpoint S3.
# Storage -> S3 keys en el panel de Supabase (access key id / secret).
SUPABASE_PROJECT_REF=vqkwrpibwotfdjokwwsi
SUPABASE_S3_BUCKET=FotosMaquinas
SUPABASE_S3_REGION=us-west-2
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Si el bucket es publico las imagenes se sirven sin firmar en
# https://<ref>.supabase.co/storage/v1/object/public/<bucket>/<ruta>
# Alternativa: montar un disco de Render y usar MEDIA_ROOT=/var/data/media
# (las dos cosas a la vez no tiene sentido; gana SUPABASE_S3_BUCKET).
